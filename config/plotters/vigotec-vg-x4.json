{
  "id": "vigotec-vg-x4",
  "label": "VigoTec VG-X4 / VG-A4",
  "page": {
    "widthMm": 297,
    "heightMm": 210
  },
  "gcode": {
    "unit": "mm",
    "feedRateMmPerMin": 1200,
    "travelCommand": "G1",
    "travelFeedRateMmPerMin": 1200,
    "penUpCommand": "M5\nG4 P1",
    "penDownCommand": "M3 S400\nG4 P1",
    "verticalFlip": true
  },
  "transport": {
    "kind": "serial",
    "baudRate": 115200,
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "flowControl": "none",
    "lineEnding": "lf",
    "responseMode": "ack",
    "ackPattern": "^(ok|OK)$",
    "errorPattern": "^(error|ERROR|alarm|ALARM)",
    "readyPattern": "^(Grbl|start)",
    "alarmResetCommand": "$X",
    "ackTimeoutMs": 3000,
    "lineDelayMs": 0
  }
}
